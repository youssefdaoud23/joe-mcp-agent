#!/bin/sh
set -eu

TOKEN_FILE="${JOE_GIT_TOKEN_FILE:-/var/lib/joe-mcp-work/.secrets/github.token}"
PROMPT="${1:-}"

case "$PROMPT" in
  *sername*|*Username*)
    printf '%s\n' 'x-access-token'
    ;;
  *assword*|*Password*)
    [ -r "$TOKEN_FILE" ] || exit 1
    IFS= read -r TOKEN < "$TOKEN_FILE"
    [ -n "$TOKEN" ] || exit 1
    printf '%s\n' "$TOKEN"
    ;;
  *)
    exit 1
    ;;
esac
