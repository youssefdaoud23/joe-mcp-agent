[Unit]
Description=Joe MCP Guarded Managed Node Updater
After=network-online.target joe-mcp-node-agent.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=@PROJECT_ROOT@
ExecStartPre=/bin/sleep 2
ExecStart=/usr/bin/python3 @PROJECT_ROOT@/scripts/managed_node_update.py @PROJECT_ROOT@
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@PROJECT_ROOT@ /var/lib/joe-mcp-agent /var/lib/joe-mcp-work /etc/systemd/system /usr/local/libexec /usr/local/bin /run/joe-mcp /run/joe-mcp-session
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
